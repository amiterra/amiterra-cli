# =============================================================================
# Amiterra Tuning Pipeline — Performance Profile
# =============================================================================
# WARNING: This file is part of the Amiterra tuning pipeline.
# Public documentation and audits MUST reference these exact sources.
# Do not edit values without updating docs and running the tune test suite.
#
# Layer:      Performance Profile (applied only by explicit `ami tune apply`)
# Scope:      Kernel networking, virtual memory, file capacity, inotify
# Reversible: yes (`ami tune rollback` restores the captured baseline)
# Embedded:   compiled into the ami binary via include_str! (build-time)
# Source:     tuning/performance.sysctl
# Docs:       https://github.com/amiterra/amiterra-cli/tree/main/tuning
# =============================================================================
#
# Format: native sysctl drop-in (`key = value`). Comments start with `#`.
# This exact text is written to /etc/sysctl.d/99-amiterra-tune.conf.
#
# Every key MUST pass SecurityGuardrails (src/guardrails.rs). Absolute
# blacklist (core_pattern, modprobe, ip_forward, panic*, unprivileged_bpf...)
# must NEVER appear here — those are policy, not performance.

# --- OS subsystem: kernel networking (TCP / BPF / ARP / neighbour) ---------
net.core.bpf_jit_enable = 1
net.core.bpf_jit_harden = 2
net.core.somaxconn = 32768
net.core.netdev_max_backlog = 16384
net.ipv4.tcp_max_syn_backlog = 16384
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.neigh.default.gc_thresh1 = 4096
net.ipv4.neigh.default.gc_thresh2 = 8192
net.ipv4.neigh.default.gc_thresh3 = 16384
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.default.rp_filter = 0
net.ipv4.conf.all.arp_announce = 2
net.ipv4.conf.all.arp_ignore = 1

# --- OS subsystem: file descriptor & inode capacity -------------------------
fs.file-max = 2097152
fs.nr_open = 2097152
fs.inotify.max_user_instances = 8192
fs.inotify.max_user_watches = 524288

# --- OS subsystem: virtual memory (swap behaviour) -------------------------
# Prefer RAM over swap-out for latency-sensitive data services.
vm.swappiness = 0
